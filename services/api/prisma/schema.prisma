// Book of Mormon Study Tools - Database Schema
// See API_SPECIFICATION.md and ADR-003 for architecture context

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Users and Authentication
// ============================================================================

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String   // Hashed with bcrypt
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  preferences      UserPreferences?
  highlights       Highlight[]
  notes            Note[]
  readingProgress  ReadingProgress[]
  studyStreak      StudyStreak?
  memoryCards      MemoryCard[]
  groupMemberships GroupMember[]
  notifications    Notification[]

  @@map("users")
}

model UserPreferences {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Display preferences
  language              String  @default("en")
  fontSize              String  @default("medium") // small, medium, large, extra-large
  theme                 String  @default("light")  // light, dark, sepia, auto

  // Notifications
  notificationsEnabled  Boolean @default(true)
  dailyReminderTime     String? // Format: "HH:MM" in user's timezone

  // AI features
  semanticSearchEnabled    Boolean @default(true)
  chatbotEnabled           Boolean @default(true)
  autoSuggestionsEnabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================================
// Scripture Content (Read-Only - populated via seed)
// ============================================================================

// Scripture works (Book of Mormon, Doctrine & Covenants, Bible)
model ScriptureWork {
  id           String    @id // "book-of-mormon", "doctrine-and-covenants", "bible"
  name         String    // "Book of Mormon", "Doctrine and Covenants", "Holy Scriptures"
  abbreviation String    // "BoM", "D&C", "Bible"
  description  String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  editions     Edition[]

  @@map("scripture_works")
}

// Editions of scripture works (e.g., CoC 1908 BoM, LDS 2013 BoM, Inspired Version)
model Edition {
  id                   String        @id // "coc-bom-1908", "lds-bom-2013", "coc-dc-2017", "iv-bible-1867"
  workId               String
  work                 ScriptureWork @relation(fields: [workId], references: [id])

  name                 String        // "Community of Christ Book of Mormon (1908)"
  shortName            String        // "CoC BoM"
  publisher            String        // "Herald Publishing House"
  year                 Int           // 1908, 2013, etc.
  language             String        @default("en")

  versificationSystem  String        // "original-chapters", "pratt-1879", "section-numbering"
  description          String?       @db.Text

  // Copyright and licensing
  isPublicDomain       Boolean       @default(false)
  copyrightHolder      String?       // "Community of Christ", "LDS Church", etc.
  licenseNotes         String?       @db.Text

  // Metadata
  isDefault            Boolean       @default(false) // Default edition for this work
  isPrimary            Boolean       @default(false) // Primary edition for CoC users
  displayOrder         Int           @default(0)     // For UI sorting

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Relations
  verses               Verse[]

  @@index([workId])
  @@index([isDefault])
  @@index([displayOrder])
  @@map("editions")
}

// Individual verses within an edition
model Verse {
  id        String  @id // Format: "coc-bom-1908:1-nephi-3-7"
  editionId String
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  // Reference components
  book      String  // "1 Nephi", "Doctrine and Covenants", "Genesis"
  chapter   Int     // Chapter number
  verse     Int     // Verse number

  // Text content
  text      String  @db.Text

  // Metadata
  verseType String  @default("standard") // "standard", "heading", "footnote", "summary"

  // Relations
  highlights           Highlight[]
  notes                Note[]
  crossReferencesFrom  CrossReference[]      @relation("FromVerse")
  crossReferencesTo    CrossReference[]      @relation("ToVerse")
  memoryCards          MemoryCard[]
  equivalentVerses     VerseMapping[]        @relation("FromVerseMapping")
  mappedFromVerses     VerseMapping[]        @relation("ToVerseMapping")

  @@unique([editionId, book, chapter, verse])
  @@index([editionId, book, chapter])
  @@index([editionId, book])
  @@map("verses")
}

// Cross-edition verse mapping (e.g., CoC III Nephi 5:8 = LDS 3 Nephi 11:7)
model VerseMapping {
  id          String   @id @default(cuid())
  fromVerseId String
  fromVerse   Verse    @relation("FromVerseMapping", fields: [fromVerseId], references: [id], onDelete: Cascade)
  toVerseId   String
  toVerse     Verse    @relation("ToVerseMapping", fields: [toVerseId], references: [id], onDelete: Cascade)

  mappingType String   // "exact" (1:1), "partial" (content overlap), "merged" (many:1), "split" (1:many)
  confidence  Float    @default(1.0) // 0.0-1.0 for algorithmic mappings

  // Metadata
  verified    Boolean  @default(false) // Manually verified by scholars
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([fromVerseId, toVerseId])
  @@index([fromVerseId])
  @@index([toVerseId])
  @@map("verse_mappings")
}

// ============================================================================
// User Study Data
// ============================================================================

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verseId   String
  verse     Verse    @relation(fields: [verseId], references: [id])
  color     String   // yellow, blue, green, pink, orange, purple
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, verseId]) // One highlight per verse per user
  @@index([userId])
  @@map("highlights")
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verseId   String
  verse     Verse    @relation(fields: [verseId], references: [id])
  content   String   @db.Text
  tags      String[] // Array of tag strings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([verseId])
  @@map("notes")
}

model CrossReference {
  id         String   @id @default(cuid())
  fromVerseId String
  fromVerse   Verse    @relation("FromVerse", fields: [fromVerseId], references: [id])
  toVerseId   String
  toVerse     Verse    @relation("ToVerse", fields: [toVerseId], references: [id])
  type        String   // official, ai_suggested, user_created
  confidence  Float?   // For AI-suggested references (0-1)
  createdAt   DateTime @default(now())

  @@unique([fromVerseId, toVerseId, type])
  @@index([fromVerseId])
  @@index([toVerseId])
  @@map("cross_references")
}

model ReadingProgress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book       String
  chapter    Int
  verse      Int
  percentage Float    // 0-100
  lastReadAt DateTime @default(now())

  @@unique([userId, book, chapter])
  @@index([userId])
  @@map("reading_progress")
}

model StudyStreak {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastStudyDate  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("study_streaks")
}

// ============================================================================
// Memory System (Spaced Repetition)
// ============================================================================

model MemoryCard {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verseId        String
  verse          Verse    @relation(fields: [verseId], references: [id])

  // SM-2 Algorithm fields
  easeFactor     Float    @default(2.5)  // 1.3 - 3.0
  interval       Int      @default(1)    // Days until next review
  repetition     Int      @default(0)    // Number of successful reviews
  nextReview     DateTime @default(now())

  // Study history
  lastReviewed   DateTime?
  totalReviews   Int      @default(0)
  correctReviews Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, verseId])
  @@index([userId, nextReview])
  @@map("memory_cards")
}

// ============================================================================
// Group Study Features
// ============================================================================

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  imageUrl    String?
  isPrivate   Boolean  @default(false)
  inviteCode  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members      GroupMember[]
  discussions  Discussion[]

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member") // admin, moderator, member
  joinedAt  DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model Discussion {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  verseId   String
  title     String
  content   String   @db.Text
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  comments  Comment[]

  @@index([groupId])
  @@map("discussions")
}

model Comment {
  id           String   @id @default(cuid())
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  authorId     String
  content      String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([discussionId])
  @@map("comments")
}

// ============================================================================
// Notifications
// ============================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // daily_reminder, streak_milestone, new_feature, system
  title     String
  body      String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================================
// AI/ML Data
// ============================================================================

model AIInteraction {
  id        String   @id @default(cuid())
  userId    String
  question  String   @db.Text
  answer    String   @db.Text
  sources   String[] // Array of verse IDs
  confidence Float   // 0-1
  feedback  String?  // helpful, not_helpful, null
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt]) // Composite index for analytics queries
  @@map("ai_interactions")
}

model SearchQuery {
  id         String   @id @default(cuid())
  userId     String?
  query      String
  type       String   // keyword, semantic, hybrid
  resultCount Int
  clickedResults String[] // Array of verse IDs that were clicked
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt]) // Composite index for analytics queries
  @@map("search_queries")
}

// ============================================================================
// Analytics (Privacy-Friendly)
// ============================================================================

model SessionEvent {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String
  eventType  String   // app_open, verse_read, search, highlight_create, etc.
  eventData  Json?    // Flexible JSON data for event-specific information
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([eventType])
  @@index([createdAt])
  @@map("session_events")
}
