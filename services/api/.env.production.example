# Production Environment Configuration
# SECURITY: Never commit actual secrets to version control

# Server Configuration
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Database (Use environment-specific secrets management)
DATABASE_URL=REPLACE_WITH_PRODUCTION_DATABASE_URL
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_SSL=true

# Redis (Use managed Redis service)
REDIS_URL=REPLACE_WITH_PRODUCTION_REDIS_URL
REDIS_TTL=3600
REDIS_TLS=true

# Authentication (Use strong secrets from vault/parameter store)
JWT_SECRET=REPLACE_WITH_PRODUCTION_JWT_SECRET_256_BITS
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# AI/ML Services (Use secure API key management)
OPENAI_API_KEY=REPLACE_WITH_PRODUCTION_OPENAI_KEY
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.3

# Vector Database
QDRANT_URL=REPLACE_WITH_PRODUCTION_QDRANT_URL
QDRANT_API_KEY=REPLACE_WITH_PRODUCTION_QDRANT_API_KEY

# Analytics
MATOMO_URL=https://your-analytics-domain.com
MATOMO_SITE_ID=1

# Logging
LOG_LEVEL=warn
LOG_PRETTY=false

# CORS (Restrict to production domains only)
CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com

# Rate Limiting (Production settings)
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW=3600000

# File Uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png

# Security Headers
HELMET_ENABLED=true
HSTS_MAX_AGE=31536000

# Feature Flags
ENABLE_AI_CHAT=true
ENABLE_SEMANTIC_SEARCH=true
ENABLE_RECOMMENDATIONS=true