# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://username:secure_password@localhost:5432/bom_study_tools
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis (Caching)
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# Authentication
JWT_SECRET=REPLACE_WITH_256_BIT_RANDOM_STRING_MINIMUM_32_CHARS
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# AI/ML Services
OPENAI_API_KEY=REPLACE_WITH_ACTUAL_OPENAI_API_KEY
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.3

# Vector Database (Semantic Search)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Analytics (Matomo)
MATOMO_URL=https://analytics.gospellibrary.org
MATOMO_SITE_ID=1

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:19006
# Production CORS should be specific domains: https://yourdomain.com,https://app.yourdomain.com

# Rate Limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=3600000

# File Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf

# Feature Flags
ENABLE_AI_CHAT=true
ENABLE_SEMANTIC_SEARCH=true
ENABLE_RECOMMENDATIONS=true
