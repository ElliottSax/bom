# ============================================================================
# Production Environment Configuration Template
# IMPORTANT: Copy this to .env.production and fill in real values
# NEVER commit .env.production to git
# ============================================================================

# Server Configuration
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=warn

# Database Configuration
DATABASE_URL=postgresql://REPLACE_DB_USER:REPLACE_DB_PASSWORD@postgres:5432/bom_production
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_TTL=3600

# Authentication & Security
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_MINIMUM_64_CHARACTER_RANDOM_STRING
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS Configuration
# Example: https://app.bomstudytools.com,https://www.bomstudytools.com
CORS_ORIGIN=https://yourdomain.com

# Rate Limiting
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW=3600000

# AI/ML Services
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.3

# Vector Database (Semantic Search)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# File Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf

# Feature Flags
ENABLE_AI_CHAT=true
ENABLE_SEMANTIC_SEARCH=true
ENABLE_RECOMMENDATIONS=true

# Monitoring & Analytics
# Optional: Set up Sentry for error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Email Service (for password reset, etc.)
# Example: SendGrid, Mailgun, AWS SES
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@bomstudytools.com

# Application URL
APP_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com

# Health Check Secret (optional, for authenticated health checks)
HEALTH_CHECK_SECRET=

# ============================================================================
# Security Checklist Before Deployment:
# ============================================================================
# [ ] JWT_SECRET is at least 64 characters and truly random
# [ ] DATABASE_URL uses strong password (20+ characters)
# [ ] CORS_ORIGIN only includes your actual domains
# [ ] OPENAI_API_KEY is valid and has spending limits set
# [ ] All REPLACE_WITH_* values have been replaced
# [ ] This file is listed in .gitignore
# [ ] Backup of this file stored securely (password manager)
# ============================================================================
