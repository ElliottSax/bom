# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (Community of Christ Scripture Study Tools)
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/bom_study_tools_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis (Caching)
REDIS_URL=redis://localhost:6382
REDIS_TTL=3600

# Authentication
JWT_SECRET=8v6EVpgYcG8j3AdvmdQFfbzLnqph0eYjjjzKs63Z3CY=
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# AI/ML Services (Optional for Phase 1)
# OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3

# Vector Database (Semantic Search - Phase 2)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Analytics (Matomo - disabled for development)
MATOMO_URL=
MATOMO_SITE_ID=

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

# CORS (Allow localhost web app and mobile development)
CORS_ORIGIN=http://localhost:3000,http://localhost:19006,exp://localhost:19000

# Rate Limiting (generous for development)
RATE_LIMIT_MAX=10000
RATE_LIMIT_WINDOW=3600000

# File Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf

# Feature Flags (Enable all for development)
ENABLE_AI_CHAT=false
ENABLE_SEMANTIC_SEARCH=false
ENABLE_RECOMMENDATIONS=false
