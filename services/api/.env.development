# Development Environment Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (using custom port to avoid conflicts)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bom_study_tools_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis (using custom port to avoid conflicts)
REDIS_URL=redis://localhost:6381
REDIS_TTL=3600

# Authentication
JWT_SECRET=a4efca5539ca76b1065c846bead7071ea6cebd840e79e1c0542124cfb6678f87
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# AI/ML Services (optional for development)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.3

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Analytics (disabled for development)
MATOMO_URL=
MATOMO_SITE_ID=

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

# CORS (allow localhost for development)
CORS_ORIGIN=http://localhost:3000,http://localhost:19006,exp://localhost:19000

# Rate Limiting (relaxed for development)
RATE_LIMIT_MAX=10000
RATE_LIMIT_WINDOW=3600000

# File Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf

# Feature Flags
ENABLE_AI_CHAT=false
ENABLE_SEMANTIC_SEARCH=false
ENABLE_RECOMMENDATIONS=false

# Mail (using MailHog for development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@bom-dev.local