# Production Environment Configuration
# SECURITY: Never commit actual secrets to version control!
# Use environment variables or secrets management (AWS Secrets Manager, Vault, etc.)

# Server Configuration
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Database Configuration
# REQUIRED: Set via environment variable or secrets manager
DATABASE_URL=${DATABASE_URL}
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# Redis Configuration
# REQUIRED: Set via environment variable or secrets manager
REDIS_URL=${REDIS_URL}
REDIS_TTL=3600

# Authentication & Security
# REQUIRED: Generate with: openssl rand -hex 32
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
SESSION_SECRET=${SESSION_SECRET}

# AI/ML Services
# OPTIONAL: Set if using AI features
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=1000

# Vector Database (Qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=${QDRANT_API_KEY}

# CORS Configuration
# REQUIRED: Set to your actual production domains
CORS_ORIGIN=https://bomstudytools.org,https://app.bomstudytools.org

# Rate Limiting (Production values)
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW=3600000

# File Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf
UPLOAD_STORAGE_PROVIDER=local

# Analytics (Matomo)
MATOMO_URL=https://analytics.bomstudytools.org
MATOMO_SITE_ID=1
MATOMO_AUTH_TOKEN=${MATOMO_AUTH_TOKEN}

# Logging
LOG_LEVEL=warn
LOG_PRETTY=false

# Feature Flags
ENABLE_AI_CHAT=true
ENABLE_SEMANTIC_SEARCH=true
ENABLE_RECOMMENDATIONS=true

# Email Service (Production)
EMAIL_PROVIDER=smtp
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}
EMAIL_FROM=noreply@bomstudytools.org

# Monitoring & Observability
SENTRY_DSN=${SENTRY_DSN}

# Cache Configuration
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=3600

# Security Headers
HELMET_ENABLED=true
HSTS_MAX_AGE=31536000

# Rate Limiting Per Endpoint
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=900000
API_RATE_LIMIT_MAX=500
API_RATE_LIMIT_WINDOW=3600000
AI_RATE_LIMIT_MAX=50
AI_RATE_LIMIT_WINDOW=3600000
