# Development Environment Variables for Mobile App
# React Native/Expo uses EXPO_PUBLIC_ prefix to expose vars to client

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:4000/graphql

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=false

# App Configuration
EXPO_PUBLIC_APP_NAME=BOM Study Tools (Dev)
EXPO_PUBLIC_APP_VERSION=0.1.0-dev

# Environment
EXPO_PUBLIC_ENVIRONMENT=development
