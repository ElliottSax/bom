# Example Environment Variables for Mobile App
# Copy this to .env.production and fill in your values

# API Configuration
EXPO_PUBLIC_API_URL=https://api.bomstudytools.org/graphql

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=true

# Analytics (Add your IDs)
EXPO_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id_here
EXPO_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token_here

# Crash Reporting (Add your Sentry DSN)
EXPO_PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here

# App Configuration
EXPO_PUBLIC_APP_NAME=BOM Study Tools
EXPO_PUBLIC_APP_VERSION=1.0.0

# Environment
EXPO_PUBLIC_ENVIRONMENT=production
