# Production Environment Variables
# Copy to .env.production and fill in values

# Database
DB_USER=bom_user
DB_PASSWORD=your-secure-password-here
DATABASE_URL=postgresql://bom_user:your-secure-password-here@localhost:5432/bom_study_tools

# Redis
REDIS_PASSWORD=your-redis-password-here
REDIS_URL=redis://:your-redis-password-here@localhost:6379

# API
API_PORT=4000
JWT_SECRET=your-jwt-secret-here-minimum-32-characters
NODE_ENV=production

# Domain
DOMAIN=api.bomstudytools.org
SSL_EMAIL=admin@bomstudytools.org

# Monitoring (optional)
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@bomstudytools.org

# S3/Storage (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1